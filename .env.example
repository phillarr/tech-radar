# Required Secrets
ANTHROPIC_API_KEY="sk-ant-..."
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Optional: raises the GitHub API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=""

# Optional Overrides
CONFIG_PATH="config/sources.json"
# When true, the Slack payload is printed to stdout instead of being posted
DRY_RUN="false"
